# ============================================
# GZIP / DEFLATE COMPRESSION
# ============================================
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/x-javascript text/javascript
  AddOutputFilterByType DEFLATE application/json application/ld+json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE application/font-woff application/font-woff2 font/woff font/woff2
  AddOutputFilterByType DEFLATE application/vnd.ms-fontobject application/x-font-ttf font/ttf font/otf

  # Don't compress already-compressed formats (images, video, zip)
  SetEnvIfNoCase Request_URI \.(?:gif|jpe?g|png|webp|avif|mp4|webm|zip|gz)$ no-gzip dont-vary
</IfModule>

# ============================================
# BROWSER CACHING
# ============================================
<IfModule mod_expires.c>
  ExpiresActive On

  # Images
  ExpiresByType image/jpg "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/avif "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # Video
  ExpiresByType video/mp4 "access plus 1 year"
  ExpiresByType video/webm "access plus 1 year"

  # Fonts
  ExpiresByType font/woff "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType application/font-woff "access plus 1 year"
  ExpiresByType application/font-woff2 "access plus 1 year"
  ExpiresByType application/vnd.ms-fontobject "access plus 1 year"
  ExpiresByType font/ttf "access plus 1 year"
  ExpiresByType font/otf "access plus 1 year"

  # CSS / JS
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType application/x-javascript "access plus 1 year"
  ExpiresByType text/javascript "access plus 1 year"

  # HTML
  ExpiresByType text/html "access plus 1 hour"

  # Default fallback
  ExpiresDefault "access plus 1 month"
</IfModule>

<IfModule mod_headers.c>
  # Cache-Control headers to back up the Expires directives above
  <FilesMatch "\.(jpg|jpeg|png|webp|avif|svg|gif|ico|mp4|webm|woff|woff2|ttf|otf)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  <FilesMatch "\.html$">
    Header set Cache-Control "public, max-age=3600, must-revalidate"
  </FilesMatch>
</IfModule>


# ============================================
# URL REWRITING & ROUTING
# Site is a static export with trailingSlash: true, so every page is a
# folder containing index.html (e.g. /admin/login/ -> admin/login/index.html).
# ============================================
Options -MultiViews -Indexes
DirectoryIndex index.html
DirectorySlash On
RewriteEngine On
RewriteBase /

# 1. Force HTTPS
RewriteCond %{HTTPS} off
RewriteCond %{HTTP:X-Forwarded-Proto} !https
RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

# 2. Add the trailing slash to page URLs (/about -> /about/), never to files
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_URI} !/$
RewriteCond %{REQUEST_URI} !\.[a-zA-Z0-9]{1,5}$
RewriteRule ^(.*)$ /$1/ [R=301,L]

# 3. Keep the admin panel out of search results
<IfModule mod_headers.c>
  SetEnvIf Request_URI "^/admin" NOINDEX
  Header set X-Robots-Tag "noindex, nofollow" env=NOINDEX
</IfModule>

# 4. Handle 404 Pages
ErrorDocument 404 /404.html
